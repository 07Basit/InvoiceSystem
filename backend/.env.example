# Backend Environment Variables
# Copy this file to .env and fill in your values. Never commit .env to git.

NODE_ENV=development
PORT=3000

# SQL Server connection string (password in {braces} so special characters are safe)
DATABASE_URL="sqlserver://localhost:1433;database=manage_system;user=invoice_app;password={your-password};trustServerCertificate=true"

# CORS — comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:5173

# JWT — generate a secret with: openssl rand -hex 32  (required in production)
JWT_SECRET=change_me_to_a_long_random_secret
# "Keep me signed in" session length / default session length
JWT_EXPIRES_IN=7d
SESSION_JWT_EXPIRES_IN=12h

# Logging level: error | warn | info | debug
LOG_LEVEL=info

# ExchangeRate-API (https://www.exchangerate-api.com) key for currencies the ECB does not cover. Optional.
EXCHANGERATE_API_KEY=

# Share buttons: open Mail / WhatsApp on the machine running the server, with the invoice file attached (macOS only).
# auto = development only | on = force | off = never
# NATIVE_SHARE=auto

# Requests allowed per client per 15 minutes across the whole API (optional; default 1000 in production, 5000 in development)
# RATE_LIMIT_MAX=1000
