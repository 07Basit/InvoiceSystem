// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// DocumentType values: WORD | PDF
// SQL Server does not support native enums — validated via Zod in application layer

// ---------------------------------------------------------------------------
// Importer + Locations
// ---------------------------------------------------------------------------

model Importer {
  id               String            @id @default(cuid())
  name             String
  address          String            @db.NVarChar(Max)
  contact          String?
  email            String?
  buyerName        String?
  currency         String
  // false = "not needed": kept in the importers list (greyed out) but not offered when creating invoices
  isActive         Boolean           @default(true)
  productLists     ProductList[]
  products         Product[]
  landingLocations LandingLocation[]
  loadingLocations LoadingLocation[]
  invoices         Invoice[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?

  @@index([name])
  @@index([deletedAt])
  @@map("importers")
}

model LandingLocation {
  id                   String    @id @default(cuid())
  importerId           String
  importer             Importer  @relation(fields: [importerId], references: [id], onDelete: Cascade)
  name                 String
  portOfDischarge      String
  finalDestination     String
  countryOfDestination String
  invoices             Invoice[]
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([importerId])
  @@map("landing_locations")
}

model LoadingLocation {
  id              String    @id @default(cuid())
  importerId      String
  importer        Importer  @relation(fields: [importerId], references: [id], onDelete: Cascade)
  name            String
  portOfLoading   String
  countryOfOrigin String
  invoices        Invoice[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([importerId])
  @@map("loading_locations")
}

// A saved exporter (your company details). There can be several; each invoice copies the one it uses.
model ExporterProfile {
  id        String   @id @default(cuid())
  name      String
  address   String
  contact   String
  email     String?
  // The profile preselected when a new invoice is started (at most one)
  isDefault Boolean  @default(false)
  // false = marked "not needed": kept here, but not offered when creating invoices
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("exporter_profiles")
}

// ---------------------------------------------------------------------------
// Currency conversion (dashboard reporting)
// ---------------------------------------------------------------------------

// Singleton row holding the currency all dashboard figures are reported in.
model CurrencySettings {
  id           String   @id @default(cuid())
  baseCurrency String   @default("USD")
  updatedAt    DateTime @updatedAt

  @@map("currency_settings")
}

// Historical daily rates fetched from the rates provider and cached permanently:
// a past day's rate never changes, so each invoice keeps the rate of its own date.
model FxRate {
  id           String   @id @default(cuid())
  date         DateTime @db.Date
  fromCurrency String
  toCurrency   String
  rate         Decimal  @db.Decimal(18, 8)
  // Where the rate came from: ECB (Frankfurter) or EXCHANGERATE_API (latest rate, for recent invoices)
  source       String   @default("ECB")

  @@unique([fromCurrency, toCurrency, date])
  @@map("fx_rates")
}

// ---------------------------------------------------------------------------
// Invoice
// ---------------------------------------------------------------------------

model Invoice {
  id                         String           @id @default(cuid())
  invoiceNumber              String           @unique
  invoiceDate                DateTime
  importerId                 String
  importer                   Importer         @relation(fields: [importerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  landingLocationId          String?
  landingLocation            LandingLocation? @relation(fields: [landingLocationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  loadingLocationId          String?
  loadingLocation            LoadingLocation? @relation(fields: [loadingLocationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  exportersRef               String?
  otherReferences            String?
  awbNumber                  String?
  buyersOrder                String?
  preCarriageBy              String?
  placeOfReceiptByPreCarrier String?
  vesselFlightNo             String?
  portOfLoading              String?
  portOfDischarge            String?
  finalDestination           String?
  buyerName                  String?
  // The importer's details as they were when the invoice was made (copied, like the ports and countries):
  // editing or deleting the importer later never changes the invoice.
  importerName               String?
  importerAddress            String?
  importerContact            String?
  importerEmail              String?
  countryOfOrigin            String?
  countryOfDestination       String?
  descriptionOfGoods         String?          @db.NVarChar(Max)
  hsCode                     String?
  termsOfDelivery            String?
  termsOfPayment             String?
  currency                   String
  exporterName               String?
  exporterAddress            String?
  exporterContact            String?
  exporterEmail              String?
  bankName                   String?
  bankAccountNumber          String?
  bankIfscCode               String?
  bankSwiftCode              String?
  signName                   String?
  signImage                  String?          @db.NVarChar(Max)
  // An "actual" invoice is a full copy of an original, named "ACTUAL <number>". It points back to that original.
  actualOfId                 String?
  actualOf                   Invoice?         @relation("ActualInvoice", fields: [actualOfId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  actuals                    Invoice[]        @relation("ActualInvoice")
  // NORMAL (the default), PARTY or CUSTOM. A party invoice and a custom invoice can each make the other with "Create custom / party invoice",
  // a full copy of the opposite kind that points back to this one (its counterpart). A normal invoice has no partner.
  invoiceKind                String           @default("NORMAL") @db.NVarChar(10)
  counterpartOfId            String?
  counterpartOf              Invoice?         @relation("CounterpartInvoice", fields: [counterpartOfId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  counterparts               Invoice[]        @relation("CounterpartInvoice")
  // The number printed inside the documents of a copy (actual or counterpart): the number of the invoice it was made from,
  // saved when the copy is made so it never changes afterwards. Empty = the invoice's own number.
  printedNumber              String?
  // BOTH invoices keep their custom page as a second, hidden invoice (kind CUSTOM, pointing back at this one). It never shows on its own:
  // not in the list, totals or the Recycle Bin, and it is deleted, restored and downloaded together with its party invoice.
  isCompanion                Boolean          @default(false)
  lineItems                  LineItem[]
  totalBoxes                 Int              @default(0)
  totalNetWeight             Decimal          @default(0) @db.Decimal(12, 2)
  totalGrossWeight           Decimal?         @db.Decimal(12, 2)
  subTotal                   Decimal          @default(0) @db.Decimal(12, 2)
  roundOff                   Decimal          @default(0) @db.Decimal(12, 2)
  total                      Decimal          @default(0) @db.Decimal(12, 2)
  amountInWords              String?          @db.NVarChar(Max)
  notes                      String?          @db.NVarChar(Max)
  declaration                String?          @db.NVarChar(2000)
  // Exchange rate typed in by the user when no automatic rate exists: units of `manualRateBase` per 1 `currency`.
  manualRate                 Decimal?         @db.Decimal(18, 8)
  manualRateBase             String?
  manualRateSetAt            DateTime?
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt
  deletedAt                  DateTime?

  @@index([importerId])
  @@index([landingLocationId])
  @@index([loadingLocationId])
  @@index([invoiceNumber])
  @@index([actualOfId])
  @@index([counterpartOfId])
  @@index([invoiceDate])
  @@index([deletedAt])
  // the list (newest first, live, not a hidden page) and the totals (originals only) each read through one index
  @@index([deletedAt, isCompanion, createdAt])
  @@index([deletedAt, actualOfId, counterpartOfId])
  @@map("invoices")
}

// ---------------------------------------------------------------------------
// LineItem
// ---------------------------------------------------------------------------

model LineItem {
  id                  String  @id @default(cuid())
  invoiceId           String
  invoice             Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  marksAndNos         String?
  containerNo         String?
  descriptionOfGoods  String  @db.NVarChar(Max)
  netWeightPerPackage Decimal @db.Decimal(12, 2)
  numberOfBoxes       Int
  totalNetWeight      Decimal @db.Decimal(12, 2)
  ratePerKg           Decimal @db.Decimal(12, 2)
  totalPerBox         Decimal @db.Decimal(12, 2)
  amount              Decimal @db.Decimal(12, 2)

  @@index([invoiceId])
  @@map("line_items")
}

// ---------------------------------------------------------------------------
// Document (Word + PDF files)
// ---------------------------------------------------------------------------

model Document {
  id        String    @id @default(cuid())
  title     String
  type      String    @default("WORD")
  content   String?   @db.NVarChar(Max)
  fileUrl   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([type])
  @@index([deletedAt])
  @@index([type, deletedAt])
  @@map("documents")
}

// ---------------------------------------------------------------------------
// Authentication
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  displayName  String
  email        String?
  role         String    @default("ADMIN")
  tokenVersion Int       @default(0)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  notifications Notification[]
  drafts        Draft[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// Notifications (one row per recipient; created by the server when something notable happens)
// ---------------------------------------------------------------------------

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // success | info | warning | error
  category  String // invoice | importer | currency | system
  title     String
  message   String?   @db.NVarChar(Max)
  // JSON array of { label, value } pairs shown on the notification page
  details   String?   @db.NVarChar(Max)
  // where "Open" should take the person, e.g. /invoices/abc, and the button text
  link      String?
  linkLabel String?
  actorName String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

// A saved bank account printed on invoices. There can be several; each invoice copies the one it uses.
model BankProfile {
  id            String   @id @default(cuid())
  bankName      String
  accountNumber String
  ifscCode      String?
  swiftCode     String?
  // The account preselected when a new invoice is started (at most one)
  isDefault     Boolean  @default(false)
  // false = marked "not needed": kept here, but not offered when creating invoices
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("bank_profiles")
}

// A product that can be picked on an invoice line. Invoices copy the name, weight and rate, so edits here never change them.
model Product {
  id                   String    @id @default(cuid())
  name                 String    @db.NVarChar(200)
  // Where this product applies. All empty = the general list; otherwise an importer, optionally narrowed to one
  // currency and one landing location (kept by name, because an importer's locations are rebuilt when it is edited).
  importerId           String?
  importer             Importer? @relation(fields: [importerId], references: [id], onDelete: Cascade)
  currency             String?   @db.NVarChar(3)
  locationName         String?   @db.NVarChar(200)
  // Usual values, filled in when the product is picked (optional; editable on the invoice)
  nettWeightPerPackage Decimal?  @db.Decimal(10, 3)
  ratePerKg            Decimal?  @db.Decimal(12, 4)
  hsCode               String?   @db.NVarChar(30)
  // false = marked "not needed": kept here, but not offered on invoices
  isActive             Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([importerId])
  @@map("products")
}

// A named list of products for one importer in one currency, optionally for one landing location (kept by name).
// Its products are the ones with the same importer, currency and location.
model ProductList {
  id           String   @id @default(cuid())
  importerId   String
  importer     Importer @relation(fields: [importerId], references: [id], onDelete: Cascade)
  currency     String   @db.NVarChar(3)
  locationName String?  @db.NVarChar(200)
  createdAt    DateTime @default(now())

  @@index([importerId])
  @@map("product_lists")
}

// A saved seal & signature image printed on invoices. There can be several; each invoice copies the one it uses.
model SignProfile {
  id        String   @id @default(cuid())
  name      String
  // PNG or JPEG as a data URL (resized in the browser before upload)
  image     String   @db.NVarChar(Max)
  // The sign preselected when a new invoice is started (at most one)
  isDefault Boolean  @default(false)
  // false = marked "not needed": kept here, but not offered when creating invoices
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sign_profiles")
}

// A saved declaration text printed on invoices. There can be several; each invoice copies the one it uses.
model DeclarationProfile {
  id        String   @id @default(cuid())
  name      String
  text      String   @db.NVarChar(Max)
  // The declaration preselected when a new invoice is started (at most one)
  isDefault Boolean  @default(false)
  // false = marked "not needed": kept here, but not offered when creating invoices
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("declaration_profiles")
}

// A form someone saved half-finished ("Save draft"): an invoice or an importer. Private to the person who saved it.
model Draft {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String // invoice | importer
  // shown in the drafts list: the invoice number or the importer name typed so far
  title     String?
  // the form's values as JSON
  data      String   @db.NVarChar(Max)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, kind, updatedAt])
  @@map("drafts")
}
